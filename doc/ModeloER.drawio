        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Definição de cores e estilos exatamente como no slide\n    classDef entidade fill:#ccccff,stroke:#333,stroke-width:1px;\n    classDef relacao fill:#cc00cc,stroke:#333,stroke-width:1px,color:#fff;\n    classDef atributo fill:#99ff99,stroke:#333,stroke-width:1px;\n\n    %% ENTIDADES (Retângulos azuis)\n    E_Equipa[Equipa]:::entidade\n    E_Jogador[Jogador]:::entidade\n    E_Jogo[Jogo]:::entidade\n    E_Evento[Evento_Jogo]:::entidade\n\n    %% RELAÇÕES (Losangos roxos)\n    R_Possui{Possui}:::relacao\n    R_Casa{Joga em Casa}:::relacao\n    R_Regista{Regista}:::relacao\n\n    %% ATRIBUTOS (Ovais verdes)\n    %% Atributos da Equipa\n    A_Eq_ID([id_equipa]):::atributo\n    A_Eq_Nome([nome]):::atributo\n    E_Equipa --- A_Eq_ID\n    E_Equipa --- A_Eq_Nome\n\n    %% Atributos do Jogador\n    A_Jog_ID([id_jogador]):::atributo\n    A_Jog_Nome([nome]):::atributo\n    A_Jog_Num([numero_camisola]):::atributo\n    E_Jogador --- A_Jog_ID\n    E_Jogador --- A_Jog_Nome\n    E_Jogador --- A_Jog_Num\n\n    %% Atributos do Jogo\n    A_Jg_ID([id_jogo]):::atributo\n    A_Jg_Est([estado]):::atributo\n    E_Jogo --- A_Jg_ID\n    E_Jogo --- A_Jg_Est\n\n    %% Atributos do Evento\n    A_Ev_ID([id_evento]):::atributo\n    A_Ev_Tipo([tipo_evento]):::atributo\n    E_Evento --- A_Ev_ID\n    E_Evento --- A_Ev_Tipo\n\n    %% LIGAÇÕES ENTIDADES &lt;-&gt; RELAÇÕES (com Cardinalidade)\n    %% Uma equipa possui N jogadores\n    E_Equipa ---|1| R_Possui\n    R_Possui ---|N| E_Jogador\n\n    %% Uma equipa joga N jogos em casa\n    E_Equipa ---|1| R_Casa\n    R_Casa ---|N| E_Jogo\n    \n    %% Um jogo regista N eventos (pontos/faltas)\n    E_Jogo ---|1| R_Regista\n    R_Regista ---|N| E_Evento&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KSkgrmj4HshKj1Lt2cw--1">
